<div id="<%= dom_id tak %>">
  <div style="display: flex; align-items: center; gap: 12px;">
    <strong style="font-size: 16px;"><%= tak.title %></strong>
    <span class="badge <%= tak.completed ? 'badge-success' : 'badge-pending' %>">
      <%= tak.completed ? "Completed" : "Pending" %>
    </span>
  </div>
</div>